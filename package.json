{
  "name": "twoitter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create twoitter-db",
    "db:migrate": "wrangler d1 execute twoitter-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute twoitter-db --remote --file=schema.sql",
    "db:migrate:001": "wrangler d1 execute twoitter-db --local --file=migrations/001_add_deleted_at.sql",
    "db:migrate:001:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/001_add_deleted_at.sql",
    "db:migrate:002": "wrangler d1 execute twoitter-db --local --file=migrations/002_add_audio_transcript.sql",
    "db:migrate:002:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/002_add_audio_transcript.sql",
    "db:migrate:003": "wrangler d1 execute twoitter-db --local --file=migrations/003_add_polls.sql",
    "db:migrate:003:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/003_add_polls.sql",
    "db:migrate:004": "wrangler d1 execute twoitter-db --local --file=migrations/004_add_location.sql",
    "db:migrate:004:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/004_add_location.sql",
    "db:migrate:005": "wrangler d1 execute twoitter-db --local --file=migrations/005_add_places.sql",
    "db:migrate:005:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/005_add_places.sql",
    "db:migrate:006": "wrangler d1 execute twoitter-db --local --file=migrations/006_add_place_owner.sql",
    "db:migrate:006:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/006_add_place_owner.sql",
    "db:migrate:007": "wrangler d1 execute twoitter-db --local --file=migrations/007_add_transcribed_at.sql",
    "db:migrate:007:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/007_add_transcribed_at.sql",
    "db:migrate:008": "wrangler d1 execute twoitter-db --local --file=migrations/008_add_lyrics.sql",
    "db:migrate:008:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/008_add_lyrics.sql",
    "db:migrate:010": "wrangler d1 execute twoitter-db --local --file=migrations/010_add_edited_at.sql",
    "db:migrate:010:remote": "wrangler d1 execute twoitter-db --remote --file=migrations/010_add_edited_at.sql",
    "r2:create": "wrangler r2 bucket create twoitter-storage"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "better-sqlite3": "^12.10.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.69.0"
  }
}
